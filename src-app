function buildPairs(staff) {
const groups = {};
staff.filter(s=>s.active).forEach(s => {
const k = `${s.dept}|${s.shift}`;
if (!groups[k]) groups[k] = [];
groups[k].push(s);
});
const pairs = [];
Object.values(groups).forEach(g => {
for (let i=0; i<g.length; i+=2) {
pairs.push(g.slice(i, i+2));
}
});
return pairs;
}

function makeICS(events) {
const lines = [‘BEGIN:VCALENDAR’,‘VERSION:2.0’,‘PRODID:-//Justrite//Staff//EN’,‘CALSCALE:GREGORIAN’,‘METHOD:PUBLISH’];
events.forEach(ev => {
const dt = ev.date.replace(/-/g,’’);
lines.push(‘BEGIN:VEVENT’,`UID:${ev.uid}@justrite.ng`,`DTSTART:${dt}T${ev.start}`,`DTEND:${dt}T${ev.end}`,`SUMMARY:${ev.summary}`,`DESCRIPTION:${ev.desc}`);
if (ev.alarm) { lines.push(‘BEGIN:VALARM’,‘ACTION:DISPLAY’,`DESCRIPTION:Shift reminder`,`TRIGGER:-PT${ev.alarm}M`,‘END:VALARM’); }
lines.push(‘END:VEVENT’);
});
lines.push(‘END:VCALENDAR’);
return lines.join(’\r\n’);
}

function downloadFile(content, name, type) {
const blob = new Blob([content], {type});
const url = URL.createObjectURL(blob);
const a = document.createElement(‘a’);
a.href = url; a.download = name;
document.body.appendChild(a); a.click();
document.body.removeChild(a); URL.revokeObjectURL(url);
}

