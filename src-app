const fmtDate = (d) => {
const dt = new Date(d);
const y = dt.getFullYear();
const m = String(dt.getMonth()+1).padStart(2,‘0’);
const day = String(dt.getDate()).padStart(2,‘0’);
return `${y}-${m}-${day}`;
};

const addDays = (ds, n) => {
const d = new Date(ds); d.setDate(d.getDate()+n); return fmtDate(d);
};

const isSun = (ds) => new Date(ds).getDay() === 0;

const getDaysInMonth = (y, m) => new Date(y, m+1, 0).getDate();

const getMonday = (ds) => {
const d = new Date(ds);
const dow = d.getDay();
const diff = dow === 0 ? -6 : 1 - dow;
d.setDate(d.getDate()+diff);
return fmtDate(d);
};

const initials = (name) => name.split(’ ‘).map(w=>w[0]).slice(0,2).join(’’).toUpperCase();

const avatarColor = (name) => {
const palette = [’#1A3A6B’,’#16A34A’,’#2563EB’,’#9333EA’,’#EA580C’,’#0891B2’,’#B45309’,’#BE185D’,’#065F46’,’#92400E’];
let hash = 0;
for (let i=0; i<name.length; i++) hash = name.charCodeAt(i) + ((hash<<5)-hash);
return palette[Math.abs(hash) % palette.length];
};

function generateRoster(staff, year, month) {
const days = getDaysInMonth(year, month);
