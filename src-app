const dow0 = firstOfMonth.getDay();
firstMondayRef.setDate(firstOfMonth.getDate() - (dow0 === 0 ? 6 : dow0 - 1));

const weekParity = (ds) => {
const d = new Date(ds);
const diff = Math.floor((d - firstMondayRef) / (7*86400000));
return diff % 2; // 0=week1, 1=week2
};

// Base assignment
for (let day=1; day<=days; day++) {
const ds = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
